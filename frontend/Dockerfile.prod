FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# Empty = same-origin /api (nginx proxies to BACKEND_URL at runtime)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf.template /etc/nginx/templates/default.conf.template

# Railway frontend service variables (runtime):
#   BACKEND_URL=https://your-backend.up.railway.app  (no trailing slash)
#   PORT=8080  (set automatically by Railway)
ENV BACKEND_URL=http://127.0.0.1:8000
ENV PORT=8080

EXPOSE 8080
