# Local dev: leave empty — Vite proxies /api to the backend.
# Railway frontend (recommended):
#   VITE_API_URL=          (empty at build — API + videos same-origin)
#   VITE_PROXY_TARGET=     (runtime on frontend service = backend public URL)
#     e.g. https://back-sc-production.up.railway.app
#
# Alternative (cross-origin API only; videos need CORP headers on backend):
# VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=

VITE_PROXY_TARGET=

# Demo videos — leave EMPTY: backend streams via /api/v1/demo-videos/{key}/stream
VITE_VIDEO_BASE_URL=
