# Local dev: leave empty — Vite proxies /api to the backend.
# Railway frontend:
#   VITE_API_URL=https://your-backend.up.railway.app  (build-time — API + vídeos /stream)
#   VITE_PROXY_TARGET= same URL (runtime, para chamadas JSON same-origin se quiser)
# Se VITE_API_URL vazio, /stream passa pelo proxy do Vite (pode dar timeout em MP4 grandes).
VITE_API_URL=

VITE_PROXY_TARGET=

# Demo videos — leave EMPTY: backend streams via /api/v1/demo-videos/{key}/stream
VITE_VIDEO_BASE_URL=
