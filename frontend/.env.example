# Local dev: leave empty — Vite proxies /api to backend.
VITE_API_URL=

# --- Railway FRONTEND (runtime) ---
# BACKEND_URL=https://your-backend.up.railway.app
# Start Command: /docker-entrypoint.sh (never npx vite preview)

# --- Railway FRONTEND (build-time) — bake videos into image, no S3 at runtime ---
# Add the SAME bucket vars to frontend service (bucket > Add to Service > frontend):
#   S3_ENDPOINT_URL, S3_BUCKET_NAME, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_REGION=auto
# Mark them available at BUILD in Railway if offered.
# Videos are served as /videos/*.mp4 from nginx — no /api/.../stream, no 403.

VITE_VIDEO_BASE_URL=
