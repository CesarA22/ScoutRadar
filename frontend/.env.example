# Local dev: leave empty — Vite proxies /api to backend (vite.config.ts).
VITE_API_URL=

# --- Railway FRONTEND service (runtime, OBRIGATÓRIO) ---
# BACKEND_URL=https://your-backend.up.railway.app
# Sem barra no final. Sem isso o site não sobe.
# Start Command no Railway: vazio (usa docker-entrypoint.sh). NÃO use npx/vite.
# Build: VITE_API_URL vazio.

# --- Railway build (optional, usually leave empty) ---
# VITE_API_URL=

# Public bucket only (rare); otherwise videos use /api/v1/demo-videos/{key}/stream
VITE_VIDEO_BASE_URL=
