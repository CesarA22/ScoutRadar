# Local dev: leave empty — Vite proxies /api and /health to the backend.
# Railway: public URL of the BACKEND service (no trailing slash).
# VITE_API_URL=https://scoutradar-backend-production.up.railway.app
VITE_API_URL=

# Demo videos — leave EMPTY to load presigned URLs from backend (private Railway bucket).
# Only set if bucket objects are public-read (virtual-hosted base, no trailing slash):
# VITE_VIDEO_BASE_URL=https://your-bucket.t3.storageapi.dev
VITE_VIDEO_BASE_URL=
