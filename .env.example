# OpenAI (required for chat + insights)
OPENAI_API_KEY=

# PostgreSQL — Railway Postgres plugin injects DATABASE_URL automatically
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5433/scoutradar

# Redis — Railway Redis plugin injects REDIS_URL automatically
REDIS_URL=redis://localhost:6379/0

# CORS: frontend origin(s), comma-separated
# Local:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Railway example (replace with your frontend public URL):
# CORS_ORIGINS=https://scoutradar-frontend-production.up.railway.app

ENV=development

# --- Frontend (frontend/.env or Railway frontend service) ---
# VITE_API_URL=   leave empty locally (Vite dev proxy)
# VITE_API_URL=https://scoutradar-backend-production.up.railway.app
