# OpenAI (required for chat + insights)
OPENAI_API_KEY=

# PostgreSQL — Railway Postgres plugin injects DATABASE_URL automatically
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5433/scoutradar

# Redis — Railway Redis plugin injects REDIS_URL automatically
REDIS_URL=redis://localhost:6379/0

# CORS: frontend origin(s), comma-separated
# Local:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Railway example (replace with your frontend public URL):
# CORS_ORIGINS=https://scoutradar-frontend-production.up.railway.app

ENV=development

# Auth (change JWT_SECRET in production)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=10080

# Default login user (seeded on startup)
SEED_USER=cesar
SEED_PASSWORD=admin@6347

# Contact form email (Resend — free tier)
# https://resend.com — create API key, use onboarding@resend.dev as sender for testing
RESEND_API_KEY=
CONTACT_TO_EMAIL=cesaraugusto213@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Railway Bucket (S3-compatible) — demo videos on landing
# No Railway: use "Add to Service" no bucket OU defina manualmente (SEM aspas nos valores):
#   ENDPOINT=https://t3.storageapi.dev
#   BUCKET=assembled-drum-xxxxx
#   ACCESS_KEY_ID=tid_...
#   SECRET_ACCESS_KEY=tsec_...
#   REGION=auto
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Ou variáveis injetadas pelo Railway "Add to Service":
# AWS_ENDPOINT_URL, AWS_S3_BUCKET_NAME, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION=auto
# Optional: only if bucket objects are public-read (otherwise backend uses presigned URLs)
S3_PUBLIC_BASE_URL=

# --- Frontend (Railway frontend service) ---
# BACKEND_URL=https://scoutradar-backend-production.up.railway.app  (runtime, nginx proxy)
# Build VITE_API_URL empty — same-origin /api (see frontend/.env.example)
